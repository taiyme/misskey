{
  "type": "module",
  "name": "mfm-js",
  "private": true,
  "upstreamVersion": "0.26.0",
  "upstreamCommit": "2192bb703247c16422876db391e52273dd1a7b74",
  "description": "An MFM parser implementation with TypeScript",
  "main": "./built/index.js",
  "types": "./built/index.d.ts",
  "exports": {
    ".": {
      "import": "./built/index.js",
      "types": "./built/index.d.ts",
      "default": "./built/index.js"
    }
  },
  "scripts": {
    "build": "node ./build.js",
    "watch": "nodemon -w package.json -e json --exec \"node ./build.js --watch\"",
    "tsd": "tsd",
    "parse": "node ./built/cli/parse.js",
    "parse-simple": "node ./built/cli/parseSimple.js",
    "api": "pnpm api-extractor run --local --verbose",
    "api-prod": "pnpm api-extractor run --verbose",
    "eslint": "eslint",
    "typecheck": "tsgo --noEmit",
    "lint": "pnpm typecheck && pnpm eslint",
    "vitest": "vitest run --coverage",
    "test": "pnpm vitest && pnpm tsd"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taiyme/misskey.git",
    "directory": "packages/mfm-js"
  },
  "author": "Marihachi",
  "license": "MIT",
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.7",
    "@types/node": "24.12.2",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "4.1.5",
    "esbuild": "0.28.0",
    "execa": "9.6.1",
    "nodemon": "3.1.14",
    "tsd": "0.33.0",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@misskey-dev/emoji-data": "17.0.0"
  },
  "files": [
    "built",
    "CHANGELOG.md"
  ]
}
